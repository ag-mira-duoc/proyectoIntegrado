# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO PARA NUAM
# ==============================================================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo a .env (cp .env.example .env)
# 2. Reemplazar los valores de ejemplo con los valores reales
# 3. NUNCA commitear el archivo .env al repositorio
# 4. Agregar .env al .gitignore
#
# RENDER DEPLOYMENT:
# - En Render, configurar estas variables en el Dashboard → Environment Variables
# - DATABASE_URL se genera automáticamente al crear la base de datos PostgreSQL
#
# ==============================================================================


# ==============================================================================
# DJANGO CORE
# ==============================================================================

# Clave secreta de Django (CAMBIAR EN PRODUCCIÓN)
# Generar con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-xyz123

# Modo debug (True solo en desarrollo, False en producción)
DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# En producción: nuam.onrender.com,www.nuam.cl
# En desarrollo: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1


# ==============================================================================
# BASE DE DATOS - POSTGRESQL
# ==============================================================================

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
#
# DESARROLLO LOCAL:
DATABASE_URL=postgresql://nuam_user:nuam_password_2025@localhost:5432/nuam_db
#
# RENDER (automático, NO configurar manualmente):
# DATABASE_URL=postgresql://user:password@host:5432/database


# ==============================================================================
# REDIS (para Celery y Caché)
# ==============================================================================

# URL de conexión a Redis
# Desarrollo local:
REDIS_URL=redis://localhost:6379/0
#
# Render (al crear servicio Redis):
# REDIS_URL=redis://red-xxxxxxxxxxxxx:6379/0


# ==============================================================================
# FIREBASE (Storage para documentos PDF)
# ==============================================================================

# Ruta al archivo JSON con credenciales de Firebase
# Solo para desarrollo local (usar variable JSON en producción)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# JSON con credenciales de Firebase (para Render)
# Copiar el contenido del archivo firebase-credentials.json como string JSON
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"nuam-prod",...}

# Nombre del bucket de Firebase Storage
FIREBASE_STORAGE_BUCKET=nuam-documentos.appspot.com


# ==============================================================================
# TESSERACT OCR
# ==============================================================================

# Ruta al ejecutable de Tesseract
# Linux/Render: /usr/bin/tesseract
# macOS (Homebrew): /usr/local/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract


# ==============================================================================
# EMAIL (Notificaciones y recuperación de contraseña)
# ==============================================================================

# Backend de email
# Desarrollo: django.core.mail.backends.console.EmailBackend
# Producción: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración SMTP (Gmail, SendGrid, Mailgun, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@tuempresa.cl
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=NUAM Sistema <noreply@tuempresa.cl>


# ==============================================================================
# SEGURIDAD Y CIFRADO
# ==============================================================================

# Clave para cifrado de campos sensibles (RUT, teléfono, email)
# DEBE ser diferente de SECRET_KEY
# Generar con: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FIELD_ENCRYPTION_KEY=GENERAR_CLAVE_FERNET_AQUI


# ==============================================================================
# CORS (para API REST)
# ==============================================================================

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# En producción:
# CORS_ALLOWED_ORIGINS=https://nuam.cl,https://www.nuam.cl,https://app.nuam.cl


# ==============================================================================
# RENDER ESPECÍFICAS (Solo para deployment en Render)
# ==============================================================================

# Versión de Python
PYTHON_VERSION=3.11.0

# Comando de build (configurar en Render Dashboard)
# BUILD_COMMAND=pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate

# Comando de inicio (configurar en Render Dashboard)
# START_COMMAND=gunicorn nuam_config.wsgi:application


# ==============================================================================
# NOTAS IMPORTANTES
# ==============================================================================

# 1. NUNCA commitear el archivo .env al repositorio
#    - Asegurarse de que .env esté en .gitignore
#
# 2. En Render, configurar variables de entorno en:
#    Dashboard → Tu servicio → Environment → Environment Variables
#
# 3. DATABASE_URL en Render:
#    - Se genera automáticamente al vincular la base de datos PostgreSQL
#    - NO configurar manualmente, Render lo hace por ti
#
# 4. Claves de cifrado:
#    - SECRET_KEY: Usar el generador de Django
#    - FIELD_ENCRYPTION_KEY: Usar Fernet.generate_key()
#    - NUNCA usar las mismas claves en desarrollo y producción
#
# 5. Seguridad:
#    - En producción, DEBUG=False SIEMPRE
#    - Usar contraseñas fuertes y únicas
#    - Rotar claves periódicamente
#
# 6. Firebase:
#    - En desarrollo: usar FIREBASE_CREDENTIALS_PATH
#    - En Render: usar FIREBASE_CREDENTIALS_JSON (string JSON completo)
#
# 7. Email:
#    - Gmail requiere "App Passwords" (no usar contraseña normal)
#    - SendGrid/Mailgun son mejores opciones para producción
#
# 8. Para generar SECRET_KEY:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# 9. Para generar FIELD_ENCRYPTION_KEY:
#    pip install cryptography
#    python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
